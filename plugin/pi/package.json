{
  "name": "qbit-jay-pi",
  "version": "0.8.0",
  "description": "Persistent memory for Pi agents — one local-or-cloud brain shared across sessions, compactions, and MCP agents",
  "type": "module",
  "license": "MIT",
  "author": "qbitdevz",
  "homepage": "https://github.com/qbitdevz/qbit-jay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbitdevz/qbit-jay.git",
    "directory": "plugin/pi"
  },
  "bin": {
    "pi-qbit-jay": "cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "qbit-jay",
    "memory",
    "persistent-memory",
    "project-memory",
    "compaction-recovery",
    "agent-memory",
    "ai-memory",
    "qbit-jay-cloud",
    "token-saving",
    "mcp",
    "coding-agent",
    "extension"
  ],
  "engram": {
    "startupPolicy": 1,
    "sessionOwned": 1
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/qbitdevz/qbit-jay/main/assets/branding/qbit-jay-banner.gif",
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "assets/",
    "cli.js",
    "compaction-recovery.js",
    "index.ts",
    "memory-tool-chrome.js",
    "mcp-template.json",
    "private-redaction.js",
    "runtime-contract.js",
    "runtime-contract.json",
    "test/",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": ">=0.74.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "typebox": "1.3.34"
  }
}
