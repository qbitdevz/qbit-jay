package dashboard

// BrandMark is the qbit-jay isotype (hexagon tile with the faceted jay head),
// inlined so it needs no request and its rim follows the theme.
// The polygons come from assets/branding/qbit-jay-isotype-dark.svg; the rim is
// drawn by CSS (.brand-mark-rim) so it is cyan on dark and the light cyan on
// light. TestBrandMarkMatchesAsset keeps the two in step.
// Decorative: the wordmark next to it carries the name.
templ BrandMark(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" class={ class } aria-hidden="true" focusable="false">
		<defs><g id="qj-iso-head" stroke-width=".8" stroke-linejoin="round"><polygon points="102,116 140,30 152,92" fill="#5B9BFF" stroke="#5B9BFF"/><polygon points="140,30 152,92 128,100" fill="#2F6FDB" stroke="#2F6FDB"/><polygon points="140,92 186,14 198,88" fill="#2F6FDB" stroke="#2F6FDB"/><polygon points="186,14 198,88 172,84" fill="#5B9BFF" stroke="#5B9BFF"/><polygon points="188,90 234,38 240,120" fill="#1B459E" stroke="#1B459E"/><polygon points="234,38 240,120 214,112" fill="#2F6FDB" stroke="#2F6FDB"/><polygon points="168,152 168,78 236,115" fill="#5B9BFF" stroke="#5B9BFF"/><polygon points="168,152 236,115 236,189" fill="#2F6FDB" stroke="#2F6FDB"/><polygon points="168,152 236,189 168,226" fill="#1B459E" stroke="#1B459E"/><polygon points="168,152 168,226 100,189" fill="#B8C5D6" stroke="#B8C5D6"/><polygon points="168,152 100,189 100,115" fill="#F2F7FD" stroke="#F2F7FD"/><polygon points="168,152 100,115 168,78" fill="#2F6FDB" stroke="#2F6FDB"/><polygon points="100,141 206,144 206,152 100,155" fill="#070B12" stroke="#070B12"/><polygon points="202,146 213,150 212,196 170,232 146,230 172,214 200,188" fill="#070B12" stroke="#070B12"/><polygon points="151.3,158 134,168 116.7,158 116.7,138 134,128 151.3,138" fill="#F2F7FD" stroke="#F2F7FD"/><polygon points="146.1,155 134,162 121.9,155 121.9,141 134,134 146.1,141" fill="#070B12" stroke="#070B12"/><polygon points="143.8,144.8 139,147.5 134.2,144.8 134.2,139.3 139,136.5 143.8,139.3" fill="#F2F7FD" stroke="#F2F7FD"/><polygon points="100,132 34,160 100,174" fill="#1C2633" stroke="#1C2633"/><polygon points="100,132 34,160 100,153" fill="#3A4A5E" stroke="#3A4A5E"/></g></defs><polygon points="116,60 88,108.5 32,108.5 4,60 32,11.5 88,11.5" fill="#0B121B" class="brand-mark-rim" stroke-width="4" stroke-linejoin="round"/><g transform="translate(60 61) scale(.385) translate(-138 -121)"><use href="#qj-iso-head"/></g>
	</svg>
}
