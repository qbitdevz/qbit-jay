package dashboard

// Layout wraps page content in the base HTML shell with nav, head, and footer.
// activeTab should be one of: "dashboard", "browser", "projects", "contributors", "admin".
// ADAPTED: username comes from Principal.DisplayName() at the call site (no context reads).
// version is the optional, display-ready build identifier rendered verbatim
// (e.g. "v1.20.3" for a semver build, "dev" for an un-versioned local build).
// Empty version displays "version unknown", as on the login page.
templ Layout(title string, username string, activeTab string, isAdmin bool, version string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="icon" type="image/svg+xml" href="/dashboard/static/qbit-jay-isotype.svg"/>
			<title>{ title } — qbit-jay Cloud</title>
			<link rel="stylesheet" href="/dashboard/static/pico.min.css"/>
			<link rel="stylesheet" href="/dashboard/static/theme.css"/>
			<link rel="stylesheet" href="/dashboard/static/styles.css"/>
			<script src="/dashboard/static/htmx.min.js"></script>
		</head>
		<body class="shell-body">
			<div class="shell-backdrop">
				<div class="status-ribbon">
					<span class="status-pill">CLOUD ACTIVE</span>
					<span class="status-copy">shared memory index / local-first replication / org policy controls</span>
				</div>
				<div class="app-shell">
					<header class="shell-header">
						<div class="brand-stack">
							<a href="/dashboard/" class="brand" aria-label="qbit-jay Cloud">
								@BrandMark("brand-mark brand-mark-glow")
								<span class="brand-word">qbit-jay</span>
								<span class="brand-product">Cloud</span>
							</a>
							<p class="brand-subtitle">Hides acorns. Remembers where.</p>
						</div>
						<div class="user-info">
							<span class="user-name">{ username }</span>
							<form method="post" action="/dashboard/logout" style="margin:0">
								<button type="submit" class="user-link logout-link">
									Logout
								</button>
							</form>
						</div>
					</header>
					<nav class="shell-nav">
						@NavTabs(activeTab, isAdmin)
					</nav>
					<main class="shell-main">
						@content
					</main>
					<footer class="shell-footer">
						<small>QBIT-JAY CLOUD / SHARED MEMORY INDEX / LIVE SYNC READY{ versionMarker(version) }</small>
					</footer>
				</div>
			</div>
		</body>
	</html>
}
